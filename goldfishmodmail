async def log_command(interaction: discord.Interaction, action_text: str):
    guild = interaction.guild
    if not guild:
        return
    log_channel = discord.utils.get(guild.text_channels, name="command_logs")
    if log_channel:
        await log_channel.send(f"log: user `{interaction.user}` executed `{action_text}` in `{interaction.channel}`")


async def apply_priority_logic(channel: discord.TextChannel, priority_level: str, interaction: discord.Interaction = None):
    ticket_priorities[channel.id] = priority_level
    clean_name = channel.name.replace("urgent-", "").replace("high-", "").replace("medium-", "")

    if priority_level == "Urgent":
        pings = " ".join([f"<@{u_id}>" for u_id in URGENT_PING_USERS])
        await channel.edit(name=f"urgent-{clean_name}")
        await channel.send(f"**URGENT TICKET ALERT** {pings}")

    elif priority_level == "High":
        pings = " ".join([f"<@{u_id}>" for u_id in HIGH_PING_USERS])
        await channel.edit(name=f"high-{clean_name}")
        await channel.send(f"**HIGH PRIORITY TICKET ALERT** {pings}")

    elif priority_level == "Medium":
        await channel.edit(name=f"medium-{clean_name}")

    elif priority_level == "Low":
        await channel.edit(name=clean_name)

    if interaction:
        await log_command(interaction, f"set priority to {priority_level}")


class PrioritySelectView(discord.ui.View):
    def __init__(self, target_user: discord.User):
        super().__init__(timeout=60)
        self.target_user = target_user

    async def apply_priority(self, interaction: discord.Interaction, priority_level: str):
        channel = interaction.channel
        if not isinstance(channel, discord.TextChannel):
            await interaction.response.send_message("invalid channel.", ephemeral=True)
            return

        await apply_priority_logic(channel, priority_level, interaction)
        await interaction.response.send_message(f"set priority to **{priority_level}**.", ephemeral=True)

        for child in self.children:
            if isinstance(child, discord.ui.Button):
                child.disabled = True
        await interaction.edit_original_response(view=self)

    @discord.ui.button(label="Low Priority", style=discord.ButtonStyle.secondary)
    async def low_prio(self, interaction: discord.Interaction, button: discord.ui.Button):
        await self.apply_priority(interaction, "Low")

    @discord.ui.button(label="Medium Priority", style=discord.ButtonStyle.primary)
    async def medium_prio(self, interaction: discord.Interaction, button: discord.ui.Button):
        await self.apply_priority(interaction, "Medium")

    @discord.ui.button(label="High Priority", style=discord.ButtonStyle.danger)
    async def high_prio(self, interaction: discord.Interaction, button: discord.ui.Button):
        await self.apply_priority(interaction, "High")

    @discord.ui.button(label="Urgent Priority", style=discord.ButtonStyle.danger)
    async def urgent_prio(self, interaction: discord.Interaction, button: discord.ui.Button):
        await self.apply_priority(interaction, "Urgent")


class InitialCategorySelectView(discord.ui.View):
    def __init__(self, target_user: discord.User):
        super().__init__(timeout=None)
        self.target_user = target_user

    async def update_category(self, interaction: discord.Interaction, category_name: str):
        status_text = f"ticket routed to **{category_name}** by {interaction.user.display_name}"
        
        for child in self.children:
            if isinstance(child, discord.ui.Button):
                child.disabled = True

        target_category_id = CATEGORY_IDS.get(category_name)
        if target_category_id and interaction.guild:
            target_category = interaction.guild.get_channel(target_category_id) or await interaction.guild.fetch_channel(target_category_id)
            if target_category and isinstance(interaction.channel, discord.TextChannel):
                await interaction.channel.edit(category=target_category)

        await interaction.response.edit_message(content=status_text, view=self)
        await log_command(interaction, f"routed ticket to category {category_name}")

        prio_view = PrioritySelectView(target_user=self.target_user)
        await interaction.followup.send(
            "please select the priority level for this ticket:",
            view=prio_view,
            ephemeral=True
        )

    @discord.ui.button(label="Admin Support", style=discord.ButtonStyle.secondary)
    async def admin_support(self, interaction: discord.Interaction, button: discord.ui.Button):
        await self.update_category(interaction, "Admin Support")

    @discord.ui.button(label="Moderation Support", style=discord.ButtonStyle.secondary)
    async def mod_support(self, interaction: discord.Interaction, button: discord.ui.Button):
        await self.update_category(interaction, "Moderation Support")

    @discord.ui.button(label="General Support", style=discord.ButtonStyle.secondary)
    async def general_support(self, interaction: discord.Interaction, button: discord.ui.Button):
        await self.update_category(interaction, "General Support")

    @discord.ui.button(label="Monitoring Council", style=discord.ButtonStyle.secondary)
    async def monitoring_council(self, interaction: discord.Interaction, button: discord.ui.Button):
        await self.update_category(interaction, "Monitoring Council")


