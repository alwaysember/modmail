@bot.event
async def on_message(message: discord.Message):
    if message.author == bot.user:
        return

    if isinstance(message.channel, discord.DMChannel):

        guild = bot.get_guild(GUILD_ID) or await bot.fetch_guild(GUILD_ID)
        if not guild:
            return

        user_id = message.author.id
        staff_channel = None
        is_first_message = False

        if user_id in active_tickets:
            staff_channel = guild.get_channel(active_tickets[user_id])

        if not staff_channel:
            is_first_message = True
            category = guild.get_channel(WAITING_CATEGORY_ID) or await guild.fetch_channel(WAITING_CATEGORY_ID)
            channel_name = f"ticket-{message.author.name}"
            
            staff_channel = await guild.create_text_channel(
                name=channel_name,
                category=category,
                topic=f"ModMail ticket for {message.author} (ID: {user_id})"
            )
            active_tickets[user_id] = staff_channel.id

            user_embed = discord.Embed(
                title="ModMail Received",
                description=(
                    "Hello, a staff member will be with you in a bit. "
                    "While waiting, do you mind explaining in as much detail "
                    "what your issue or question is?"
                ),
                color=discord.Color.blue()
            )
            await message.channel.send(embed=user_embed)

        timestamp_str = message.created_at.strftime("%m/%d/%Y %I:%M %p")
        
        staff_embed = discord.Embed(
            description=f"{message.content}\n\n`{timestamp_str}`" if message.content else f"`{timestamp_str}`",
            color=discord.Color.blue()
        )
        staff_embed.set_author(
            name=message.author.name,
            icon_url=message.author.display_avatar.url
        )

        if message.attachments:
            if message.attachments[0].content_type and message.attachments[0].content_type.startswith("image/"):
                staff_embed.set_image(url=message.attachments[0].url)
            else:
                attachment_urls = "\n".join([att.url for att in message.attachments])
                staff_embed.add_field(name="Attachments", value=attachment_urls, inline=False)

        if is_first_message:
            view = InitialCategorySelectView(target_user=message.author)
            await staff_channel.send(embed=staff_embed, view=view)
        else:
            await staff_channel.send(embed=staff_embed)

    await bot.process_commands(message)

bot.run(BOT_TOKEN)
