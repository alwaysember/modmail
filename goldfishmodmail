@bot.tree.command(name="openticket", description="Open a ModMail ticket with any user via User ID.")
@app_commands.describe(user_id="The Discord User ID of the person to open a ticket for.")
async def openticket(interaction: discord.Interaction, user_id: str):
    try:
        target_id = int(user_id.strip())
    except ValueError:
        await interaction.response.send_message("invalid user ID format. please provide a numeric user ID.", ephemeral=True)
        return

    if target_id in active_tickets:
        await interaction.response.send_message(f"a ticket already exists for user ID `{target_id}`.", ephemeral=True)
        return

    await interaction.response.defer()

    try:
        user = bot.get_user(target_id) or await bot.fetch_user(target_id)
    except discord.NotFound:
        await interaction.followup.send(f"user with ID `{target_id}` was not found on discord.", ephemeral=True)
        return
    except Exception as e:
        await interaction.followup.send(f"failed to fetch user `{target_id}`: `{e}`", ephemeral=True)
        return

    guild = interaction.guild
    category = guild.get_channel(WAITING_CATEGORY_ID) or await guild.fetch_channel(WAITING_CATEGORY_ID)
    
    channel_name = f"ticket-{user.name}"
    channel = await guild.create_text_channel(
        name=channel_name,
        category=category,
        topic=f"ModMail ticket for {user} (ID: {user.id})"
    )
    active_tickets[user.id] = channel.id

    dm_status = "successfully sent notification DM to the user."
    try:
        dm_embed = discord.Embed(
            title="Ticket Opened",
            description="A support ticket has been opened for you by staff. Reply directly to this DM to speak with us.",
            color=discord.Color.blue()
        )
        await user.send(embed=dm_embed)
    except discord.Forbidden:
        dm_status = "warning: could not DM the user (DMs are closed or they share no servers with the bot)."
    except Exception as e:
        dm_status = f"warning: failed to send DM (`{e}`)."

    await interaction.followup.send(f"opened ticket channel for **{user.name}** ({user.id}): {channel.mention}\n{dm_status}")
    await log_command(interaction, f"/openticket user_id={user_id}")


