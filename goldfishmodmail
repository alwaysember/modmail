def get_user_id_from_channel(channel_id: int):
    for u_id, c_id in active_tickets.items():
        if c_id == channel_id:
            return u_id
    return None


@bot.tree.command(name="autoreply", description="Send a pre-written auto-reply to the user.")
@app_commands.choices(preset=[
    app_commands.Choice(name="Welcome Greeting", value="welcome"),
    app_commands.Choice(name="Request More Information", value="info"),
    app_commands.Choice(name="Patience Notice", value="patience")
])
async def autoreply(interaction: discord.Interaction, preset: str):
    target_user_id = get_user_id_from_channel(interaction.channel_id)
    if not target_user_id:
        await interaction.response.send_message("this command can only be used in an active ticket channel.", ephemeral=True)
        return

    text = AUTO_REPLIES.get(preset, "no pre-written response found.")
    user = bot.get_user(target_user_id) or await bot.fetch_user(target_user_id)
    
    embed = discord.Embed(title="Support Message", description=text, color=discord.Color.blue())
    await user.send(embed=embed)
    await interaction.response.send_message(embed=discord.Embed(description=f"**Auto-Reply Sent:** {text}", color=discord.Color.blue()))
    await log_command(interaction, f"/autoreply preset={preset}")


@bot.tree.command(name="close", description="Close this ticket, optionally after a delay.")
@app_commands.describe(delay_seconds="Delay in seconds before closing (optional).")
async def close_ticket(interaction: discord.Interaction, delay_seconds: int = 0):
    target_user_id = get_user_id_from_channel(interaction.channel_id)
    channel_id = interaction.channel_id

    async def do_close():
        if delay_seconds > 0:
            await asyncio.sleep(delay_seconds)
        if target_user_id and target_user_id in active_tickets:
            del active_tickets[target_user_id]
        if channel_id in scheduled_closes:
            del scheduled_closes[channel_id]
        if channel_id in ticket_priorities:
            del ticket_priorities[channel_id]
        await interaction.channel.delete(reason="modmail ticket closed.")

    await log_command(interaction, f"/close delay_seconds={delay_seconds}")

    if delay_seconds > 0:
        task = asyncio.create_task(do_close())
        scheduled_closes[channel_id] = task
        await interaction.response.send_message(f"ticket scheduled to close in {delay_seconds} seconds. use `/cancelclose` to cancel.")
    else:
        await interaction.response.send_message("closing ticket channel...")
        await do_close()


@bot.tree.command(name="cancelclose", description="Cancel a scheduled close.")
async def cancelclose(interaction: discord.Interaction):
    channel_id = interaction.channel_id
    if channel_id in scheduled_closes:
        scheduled_closes[channel_id].cancel()
        del scheduled_closes[channel_id]
        await interaction.response.send_message("scheduled close has been cancelled.")
        await log_command(interaction, "/cancelclose")
    else:
        await interaction.response.send_message("there is no scheduled close for this channel.", ephemeral=True)


